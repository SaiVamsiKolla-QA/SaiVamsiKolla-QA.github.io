{
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-quotes": "error",
    "close-order": "error",
    "doctype-html": "error",
    "element-required-attributes": "error",
    "heading-level": "error",
    "no-dup-id": "error",
    "no-inline-style": "error",
    "no-raw-characters": "error",
    "prefer-native-element": "error",
    "require-sri": "off",
    "void-style": ["error", { "style": "omit" }]
  }
}
